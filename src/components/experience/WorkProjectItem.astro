---
import type { WorkProject } from '../../lib/content';
import Prose from '../shared/Prose.astro';
import TechTags from '../shared/TechTags.astro';
import DateRange from '../shared/DateRange.astro';
import ExternalLinks from '../shared/ExternalLinks.astro';
import DummyBadge from '../shared/DummyBadge.astro';
import { localeOf } from '../../i18n';
import { ui } from '../../i18n/ui';

interface Props {
  project: WorkProject;
}
const { project } = Astro.props;
const t = ui[localeOf(Astro)];
const hasBody = project.body.trim().length > 0;
const hasLists = project.responsibilities.length > 0 || project.achievements.length > 0;
const hasMore = hasBody || hasLists;
---

<article class="project panel">
  <header class="project__head">
    <h4>{project.name} {project.dummy && <DummyBadge />}</h4>
    {
      project.links.length > 0 && (
        <div class="project__links">
          <ExternalLinks links={project.links} />
        </div>
      )
    }
  </header>
  <p class="project__meta">
    <span class="project__role">{project.role}</span>
    {
      (project.startDate || project.endDate) && (
        <span class="pill">
          <DateRange start={project.startDate} end={project.endDate} ongoing />
        </span>
      )
    }
  </p>

  <p class="project__summary">{project.summary}</p>
  <TechTags items={project.stack} />

  {
    hasMore && (
      <details class="more">
        <summary>
          <span class="when-closed">{t.readMore}</span>
          <span class="when-open">{t.showLess}</span>
        </summary>

        <div class="more__content">
          {
            hasBody && (
              <section class="about">
                <h5>{t.about}</h5>
                <Prose markdown={project.body} headingOffset={3} />
              </section>
            )
          }
          {
            hasLists && (
              <div class="lists">
                {project.responsibilities.length > 0 && (
                  <section>
                    <h5>{t.responsibilities}</h5>
                    <ul>
                      {project.responsibilities.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                )}
                {project.achievements.length > 0 && (
                  <section>
                    <h5>{t.results}</h5>
                    <ul class="results">
                      {project.achievements.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            )
          }
        </div>
      </details>
    )
  }
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    justify-items: start;
    container-type: inline-size;
    padding: var(--space-5) var(--space-6);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }
  .project:hover {
    box-shadow: var(--shadow-lift);
  }
  .project__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    width: 100%;
  }
  .project__links {
    margin-left: auto;
    padding-top: var(--space-1);
  }
  h4 {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .project__role {
    color: var(--color-ink-soft);
    font-style: italic;
  }
  .project__summary {
    max-width: var(--measure);
  }

  .more {
    width: 100%;
    margin-top: var(--space-1);
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '+';
    display: inline-block;
    width: 1ch;
    text-align: center;
  }
  details[open] > summary::before {
    content: '–';
  }
  summary:hover span {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .when-open,
  details[open] .when-closed {
    display: none;
  }
  details[open] .when-open {
    display: inline;
  }

  .more__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    font-size: 1.1rem;
  }
  .lists {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  h5 {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .lists ul {
    display: grid;
    gap: var(--space-2);
  }
  .lists li {
    position: relative;
    padding-left: 1.1em;
  }
  .lists li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5em;
    height: 1px;
    background: var(--color-ink-soft);
  }
  .results li::before {
    background: var(--color-accent);
    height: 2px;
  }

  @container (min-width: 36rem) {
    .more__content:has(> .about):has(> .lists) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-6);
    }
  }
</style>
