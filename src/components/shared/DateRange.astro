---
import { formatRange } from '../../lib/format';
import { localeOf } from '../../i18n';

interface Props {
  start?: Date | null;
  end?: Date | null;
  /** Show "– present" when there is a start but no end. */
  ongoing?: boolean;
}
const { start, end, ongoing = false } = Astro.props;
const text = formatRange(start, end, localeOf(Astro), { ongoing });
---

{text && <span class="date-range">{text}</span>}
