---
// Rendered only for entries flagged `dummy: true`. Disappears when you remove the flag.
import { localeOf } from '../../i18n';
import { ui } from '../../i18n/ui';

const t = ui[localeOf(Astro)];
---

<span class="dummy-badge" title={t.sampleTitle}>{t.sample}</span>

<style>
  .dummy-badge {
    display: inline-block;
    padding: 0 0.4rem;
    border: 1px dashed var(--color-accent);
    border-radius: 3px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    vertical-align: middle;
  }
</style>
