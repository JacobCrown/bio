---
interface Props {
  items: string[];
}
import { localeOf } from '../../i18n';
import { ui } from '../../i18n/ui';

const { items } = Astro.props;
const t = ui[localeOf(Astro)];
---

{
  items.length > 0 && (
    <ul class="tags" aria-label={t.technologies}>
      {items.map((item) => (
        <li class="tag">{item}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
