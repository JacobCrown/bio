---
import type { ProjectStatus } from '../../schemas';
import { localeOf } from '../../i18n';
import { ui } from '../../i18n/ui';

interface Props {
  status: ProjectStatus;
}
const { status } = Astro.props;
const label = ui[localeOf(Astro)].status[status];
---

<span class={`status status--${status}`}><span class="dot" aria-hidden="true"></span>{label}</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-ink-soft);
  }
  .status--ongoing .dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .status--completed .dot {
    background: var(--color-ink-soft);
  }
</style>
