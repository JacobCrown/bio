---
import { Image } from 'astro:assets';
import type { PersonalProject } from '../../lib/content';
import { formatRange } from '../../lib/format';
import { localeOf, localePath } from '../../i18n';
import { ui } from '../../i18n/ui';
import TechTags from '../shared/TechTags.astro';
import DummyBadge from '../shared/DummyBadge.astro';
import ProjectStatus from './ProjectStatus.astro';

interface Props {
  project: PersonalProject;
}
const { project } = Astro.props;
const lang = localeOf(Astro);
const t = ui[lang];
const hasDetail = project.body.trim().length > 0;
const detailUrl = localePath(lang, `/projects/${project.id}/`);
const dates = formatRange(project.startDate, project.endDate, lang, { ongoing: project.status === 'ongoing' });
---

<article class="card panel">
  {
    project.image && (
      <Image
        class="card__image"
        src={project.image}
        alt={project.imageAlt ?? t.screenshotOf(project.name)}
        width={640}
        widths={[400, 640, 960]}
        sizes="(min-width: 48rem) 30rem, 100vw"
      />
    )
  }
  <div class="card__body">
    <header class="card__head">
      <h3>
        {hasDetail ? <a href={detailUrl}>{project.name}</a> : project.name}
        {project.dummy && <DummyBadge />}
      </h3>
      <ul class="card__links">
        {
          hasDetail && (
            <li>
              <a href={detailUrl}>{t.details} →</a>
            </li>
          )
        }
        <li>
          <a href={project.repo} rel="noopener">{t.contact.github} ↗</a>
        </li>
        {
          project.demo && (
            <li>
              <a href={project.demo} rel="noopener">{t.liveDemo} ↗</a>
            </li>
          )
        }
      </ul>
    </header>
    <p class="card__meta">
      <ProjectStatus status={project.status} />
      {dates && <span class="pill">{dates}</span>}
    </p>
    <p class="card__summary">{project.summary}</p>
    <TechTags items={project.stack} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .card:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }
  .card :global(.card__image) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .card__body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    width: 100%;
  }
  h3 {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }
  .card__summary {
    color: var(--color-ink-soft);
  }
  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-left: auto;
    padding-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .card__links a {
    text-decoration-color: var(--color-accent);
  }
</style>
