---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileHero from '../../components/profile/ProfileHero.astro';
import EducationTimeline from '../../components/education/EducationTimeline.astro';
import ExperienceTimeline from '../../components/experience/ExperienceTimeline.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import SectionHeading from '../../components/shared/SectionHeading.astro';
import SkillsSection from '../../components/skills/SkillsSection.astro';
import { collectSkills, getEducation, getEmployers, getPersonalProjects, getProfile } from '../../lib/content';
import { locales, localeOf, localePath } from '../../i18n';
import { ui } from '../../i18n/ui';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = localeOf(Astro);
const t = ui[lang];
const [profile, education, employers, projects] = await Promise.all([
  getProfile(lang),
  getEducation(lang),
  getEmployers(lang),
  getPersonalProjects(lang),
]);
const featured = projects.filter((project) => project.featured);
const skills = collectSkills([
  ...employers.flatMap((employer) => employer.projects.map((project) => project.stack)),
  ...projects.map((project) => project.stack),
]);

const fullName = `${profile.firstName} ${profile.lastName}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  jobTitle: profile.title,
  address: { '@type': 'PostalAddress', addressLocality: profile.location.city, addressCountry: profile.location.country },
  sameAs: [profile.links.github, profile.links.linkedin],
  email: `mailto:${profile.links.email}`,
};
---

<BaseLayout jsonLd={jsonLd}>
  <div class="container">
    <ProfileHero profile={profile} />

    <SkillsSection skills={skills} />

    <EducationTimeline education={education} />

    <ExperienceTimeline employers={employers} />

    {
      featured.length > 0 && (
        <section aria-labelledby="projects" class="section">
          <SectionHeading id="projects" title={t.sections.projects} href={localePath(lang, '/projects/')} linkLabel={t.allProjects} />
          <ProjectGrid projects={featured} />
        </section>
      )
    }

  </div>
</BaseLayout>

<style>
  .section {
    margin-bottom: var(--space-8);
  }
</style>
