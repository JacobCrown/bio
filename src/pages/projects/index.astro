---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { getPersonalProjects } from '../../lib/content';

const projects = await getPersonalProjects();
---

<BaseLayout title="Projects" description="Personal and open-source projects.">
  <div class="container">
    <PageHeader title="Projects" intro="Personal and open-source projects, newest first." />
    <ProjectGrid projects={projects} />
  </div>
</BaseLayout>
