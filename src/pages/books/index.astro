---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import BookTimeline from '../../components/books/BookTimeline.astro';
import { getBooks } from '../../lib/content';

const books = await getBooks();
const intro = `A personal reading journal — ${books.length} ${books.length === 1 ? 'book' : 'books'}, newest first, with my ratings and notes.`;
---

<BaseLayout title="Reading journal" description="Books I have read, with ratings, summaries and personal reviews.">
  <div class="container">
    <PageHeader title="Reading journal" intro={intro} />
    <BookTimeline books={books} />
  </div>
</BaseLayout>
