---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import { getProfile } from '../lib/content';
import { locales, localeOf, localePath, ogLocales, defaultLocale, type Locale } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Social-share image (optimised and made absolute automatically). */
  image?: ImageMetadata;
  type?: 'website' | 'article';
  /** Structured data (JSON-LD) to embed. */
  jsonLd?: Record<string, unknown>;
  /** Locales that have this exact page. Omit when every language has it. */
  availableLocales?: readonly Locale[];
  /** Path without a language prefix, used when this page has no translation. */
  missingLocalePath?: string;
}

const lang = localeOf(Astro);
const t = ui[lang];
const profile = await getProfile(lang);
const { title, description, image, type = 'website', jsonLd, availableLocales, missingLocalePath = '/' } = Astro.props;
const pageLocales = availableLocales ?? locales;

const fullName = `${profile.firstName} ${profile.lastName}`;
const pageTitle = title ? `${title} — ${fullName}` : `${fullName} — ${profile.title}`;
const pageDescription =
  description ?? t.defaultDescription(fullName, profile.title, profile.location.city, profile.location.country);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const shareImage = await getImage({ src: image ?? profile.photo, width: 1200, format: 'jpg' });
const shareImageUrl = Astro.site ? new URL(shareImage.src, Astro.site).href : shareImage.src;

const nav = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.education, href: '/#education' },
  { label: t.nav.experience, href: '/#experience' },
  { label: t.nav.projects, href: '/#projects' },
];
// Path without the language prefix ("/pl/books/x/" -> "/books/x/"), used to match the nav
// and to build the same page in the other language. Pages outside /pl/ and /en/ (404) keep their path.
const localePrefix = new RegExp(`^/(${locales.join('|')})(?=/|$)`);
const isLocalized = localePrefix.test(Astro.url.pathname);
const path = Astro.url.pathname.replace(localePrefix, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href));

const fallbackLocale = pageLocales.includes(defaultLocale) ? defaultLocale : pageLocales[0];
const alternates =
  Astro.site && isLocalized && fallbackLocale
    ? [
        ...pageLocales.map((locale) => ({ hreflang: locale, href: new URL(localePath(locale, path), Astro.site).href })),
        { hreflang: 'x-default', href: new URL(localePath(fallbackLocale, path), Astro.site).href },
      ]
    : [];
const languageSwitch = locales.map((locale) => ({
  locale,
  href: localePath(locale, !isLocalized || pageLocales.includes(locale) ? (isLocalized ? path : '/') : missingLocalePath),
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint: apply the saved theme, or follow the system preference.
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={shareImageUrl} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipToContent}</a>

    {
      profile.dummy && (
        <p class="dummy-banner">{t.sampleBanner}</p>
      )
    }

    <header class="site-header">
      <div class="container site-header__inner">
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={localePath(lang, item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav class="lang-switch" aria-label={t.languageSwitch}>
          <ul>
            {
              languageSwitch.map((item) => (
                <li>
                  <a
                    href={item.href}
                    hreflang={item.locale}
                    lang={item.locale}
                    aria-current={item.locale === lang ? 'true' : undefined}
                  >
                    {item.locale.toUpperCase()}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          aria-label={t.darkMode}
          aria-pressed="false"
          title={t.darkMode}
        >
          <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="mono">© {new Date().getFullYear()} {fullName}</p>
        <ul class="mono">
          <li><a href={profile.links.github} rel="noopener">{t.contact.github}</a></li>
          <li><a href={`mailto:${profile.links.email}`}>{t.contact.email}</a></li>
        </ul>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const syncToggle = () => toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));

      syncToggle();
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        syncToggle();
      });
    </script>
  </body>
</html>

<style>
  .dummy-banner {
    padding: var(--space-2) var(--gutter);
    background: var(--color-surface);
    border-bottom: 1px dashed var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: center;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    padding-block: var(--space-4);
    background: var(--color-header);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  nav a {
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 1px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--color-accent);
  }
  .lang-switch {
    margin-left: auto;
  }
  .lang-switch ul {
    gap: var(--space-1) var(--space-3);
  }
  .lang-switch a[aria-current='true'] {
    border-bottom-color: var(--color-accent);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: var(--space-5);
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .theme-toggle:hover,
  .theme-toggle[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .icon {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Show the icon for the action: moon in light mode, sun in dark mode. */
  .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon { display: none; }
  :root[data-theme='dark'] .icon-sun { display: block; }

  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .site-footer__inner,
  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .site-footer__inner {
    justify-content: space-between;
  }
</style>
